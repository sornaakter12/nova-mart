rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'admin@store.com' ||
        request.auth.token.email == 'j41975994@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create: if isAdmin() && isValidId(productId) &&
        incoming().keys().hasAll(['title', 'price', 'category', 'stock']) &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().price is number && incoming().price >= 0 &&
        incoming().stock is number && incoming().stock >= 0;
      allow update: if isAdmin() && isValidId(productId);
      allow delete: if isAdmin() && isValidId(productId);
    }

    // Customer orders
    match /orders/{orderId} {
      // Customer can get their own order, or admin can inspect any order
      allow get: if isValidId(orderId) && (
        (isSignedIn() && existing().userId == request.auth.uid) ||
        isAdmin()
      );
      
      // List orders: customers can list only orders where userId matches, admin can list all
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // Customers can create orders with validated schema
      allow create: if isValidId(orderId) && (
        incoming().keys().hasAll(['orderNumber', 'customerName', 'customerPhone', 'shippingAddress', 'total', 'orderStatus', 'paymentMethod']) &&
        incoming().orderNumber is string && incoming().orderNumber.size() <= 64 &&
        incoming().customerName is string && incoming().customerName.size() <= 200 &&
        incoming().customerPhone is string && incoming().customerPhone.size() <= 50 &&
        incoming().shippingAddress is string && incoming().shippingAddress.size() <= 500 &&
        incoming().total is number && incoming().total >= 0 &&
        incoming().orderStatus in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
        incoming().paymentMethod in ['cash_on_delivery', 'online_payment'] &&
        (!isSignedIn() || incoming().userId == request.auth.uid)
      );

      // Only administrators can update order status or fulfillments
      allow update: if isAdmin() && isValidId(orderId);
      allow delete: if isAdmin() && isValidId(orderId);
    }

    // User accounts
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow create, update: if isValidId(userId) && isOwner(userId) &&
        (!incoming().keys().hasAny(['role']) || incoming().role == 'customer' || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins registry
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if false; // Configured via backend server / console only
    }
  }
}
